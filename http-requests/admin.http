###
#admin
POST http://localhost:9999/api/v1/auth/register
Content-Type: application/json

{
  "login": "AdminTest1",
  "password": "adminadmin",
  "role": "admin"
}


###
POST http://localhost:9999/api/v1/auth/login
Content-Type: application/json

{
  "login": "AdminTest1",
  "password": "adminadmin"
}

> {%
    client.global.set("accessToken", response.body.access_token);
%}

