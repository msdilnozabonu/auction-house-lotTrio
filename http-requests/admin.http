#seller
POST http://localhost:9999/api/v1/auth/register
Content-Type: application/json

{
  "login": "SellerTest1",
  "password": "sellerpass",
  "role": "seller"
}

###
POST http://localhost:9999/api/v1/auth/login
Content-Type: application/json

{
  "login": "SellerTest1",
  "password": "sellerpass"
}

> {%
    client.global.set("sellerToken", response.body.access_token);
%}


